{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site",
  "main": "worker/index.ts",
  // Purge quotidienne des donnees arrivees au terme de leur conservation.
  // 03h15 UTC : hors des heures d'usage, et decale d'un quart d'heure pour ne
  // pas tomber avec le reste du monde sur l'heure ronde.
  "triggers": { "crons": ["15 3 * * *"] },
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    // Boite de demonstration : fermee sur le worker deploye.
    // isDemoInboxEnabled exige deja un hote local, mais le verrou ne doit pas
    // tenir a cette seule verification : en ligne, la variable dit non.
    // Le poste de developpement garde sa boite par DEMO_INBOX dans .env.
    "DEMO_INBOX": "false",
    "AUTH_TRUST_HOST": "true"
  },
  // Fichiers deposes : bordereaux d'import et pieces de salle de donnees.
  // Workers n'a pas de systeme de fichiers, ces fichiers vivent dans R2.
  // En local, wrangler simule ce bucket dans .wrangler/state.
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "cession-courtage-uploads"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cession-courtage",
      "database_id": "98d5a611-8101-42ef-9cf5-033fff64ca65",
      "migrations_dir": "migrations"
    }
  ]
}
