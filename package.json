{
  "name": "cession-courtage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "prisma:generate": "prisma generate",
    "db:migrate": "wrangler d1 migrations apply cession-courtage --local",
    "db:migrate:remote": "wrangler d1 migrations apply cession-courtage --remote",
    "db:seed": "SEED_D1=1 tsx prisma/seed.ts",
    "db:certify": "wrangler d1 execute cession-courtage --local --file ./scripts/d1-certify-demo.sql",
    "db:catalog": "tsx scripts/write-catalog-sql.ts && wrangler d1 execute cession-courtage --local --file ./scripts/d1-catalog-listings.sql",
    "db:catalog:remote": "tsx scripts/write-catalog-sql.ts && wrangler d1 execute cession-courtage --remote --file ./scripts/d1-catalog-listings.sql",
    "db:reset": "echo 'Arretez `npm run dev` avant de reinitialiser : la base locale est ouverte par le serveur.' && rm -rf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed && npm run db:certify",
    "setup": "prisma generate && npm run db:migrate && npm run db:seed",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.3",
    "next": "15.5.25",
    "next-auth": "^5.0.0-beta.32",
    "papaparse": "^5.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.7",
    "wrangler": "^4.129.0"
  }
}
