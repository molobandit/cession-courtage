# PostgreSQL (Docker Compose local, Neon, etc.)
DATABASE_URL="postgresql://cession:cession@localhost:5432/cession_courtage?schema=public"

# Auth.js v5. AUTH_SECRET is required (openssl rand -base64 32).
# NEXTAUTH_SECRET / NEXTAUTH_URL are aliases kept in sync for compatibility.
AUTH_SECRET="generate-a-32-byte-secret"
NEXTAUTH_SECRET="generate-a-32-byte-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# true = magic links are stored in OutboundEmail and shown on /lien-envoye and /boite-demo (no SMTP).
DEMO_INBOX="true"

# Binary uploads (data room, imports). Hashes in DB, files on disk. Not a public CDN.
FILE_STORAGE_DIR="./uploads"
