# Base de données : Cloudflare D1 uniquement (binding `DB` déclaré dans wrangler.jsonc).
# En local, `next dev` reçoit le binding via initOpenNextCloudflareForDev() (next.config.ts),
# et les données vivent dans .wrangler/state/v3/d1. Aucune DATABASE_URL n'est utilisée.

# Auth.js v5. AUTH_SECRET est obligatoire : openssl rand -base64 32
# NEXTAUTH_SECRET / NEXTAUTH_URL sont des alias maintenus identiques pour compatibilité.
AUTH_SECRET="generate-a-32-byte-secret"
NEXTAUTH_SECRET="generate-a-32-byte-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Stripe — abonnement 250 € HT / 300 € TTC. Clés hors git (wrangler secret).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# true = les liens magiques sont écrits dans OutboundEmail et affichés sur
# /lien-envoye et /boite-demo. Aucun envoi SMTP réel.
DEMO_INBOX="true"
