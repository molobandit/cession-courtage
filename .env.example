# PostgreSQL (local docker-compose or Vercel/Neon)
DATABASE_URL="postgresql://cession:cession@localhost:5432/cession_courtage?schema=public"

AUTH_SECRET="generate-a-32-byte-secret"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Set to "true" to display magic links on the confirmation page (no SMTP).
DEMO_INBOX="true"

FILE_STORAGE_DIR="./uploads"
