# Base de données : Cloudflare D1 uniquement (binding `DB` déclaré dans wrangler.jsonc).
# En local, `next dev` reçoit le binding via initOpenNextCloudflareForDev() (next.config.ts),
# et les données vivent dans .wrangler/state/v3/d1. Aucune DATABASE_URL n'est utilisée.

# Auth.js v5. AUTH_SECRET est obligatoire : openssl rand -base64 32
# NEXTAUTH_SECRET / NEXTAUTH_URL sont des alias maintenus identiques pour compatibilité.
AUTH_SECRET="generate-a-32-byte-secret"
NEXTAUTH_SECRET="generate-a-32-byte-secret"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Stripe — abonnement 250 € HT / 300 € TTC. Clés hors git (wrangler secret).
# Paiement. Une cle sk_test_ n'encaisse rien : seules les cartes d'essai de
# Stripe y passent. Une cle sk_live_ est refusee tant que STRIPE_ALLOW_LIVE
# n'est pas explicitement pose a "true" — garde volontaire, le site sert
# aujourd'hui a des demonstrations sur des portefeuilles fictifs.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# STRIPE_ALLOW_LIVE="true"
#
# Cartes d'essai Stripe (mode sk_test_ uniquement, aucun debit) :
#   4242 4242 4242 4242  paiement accepte
#   4000 0000 0000 0002  refuse par la banque
#   4000 0000 0000 9995  provision insuffisante
#   4000 0025 0000 3155  demande une authentification 3D Secure
# Date d'expiration : n'importe quelle date future. Cryptogramme : 3 chiffres.

# Circuit de confiance (contrats à valider, puis wrangler secret put).
# Sans ces clés, le dossier enregistre les étapes sans mouvement d'argent.
# TRUSTAP_API_KEY=""
# YOUSIGN_API_KEY=""
# DOCUSIGN_API_KEY=""
# SIGNATURE_PROVIDER="yousign"
# IDENTITY_API_KEY=""
# FINANCING_PARTNER_LIVE="true"

# Agenda conseiller : coller l’adresse iCal secrète (Google / Outlook) dans /admin/agenda.
